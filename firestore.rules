rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper checks
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (getUserData().role == 'admin' || getUserData().role == 'Admin' || getUserData().role == 'Administrador');
    }

    function isStore() {
      return isAuthenticated() && (getUserData().role == 'store' || getUserData().role == 'Tienda');
    }

    function isCourier() {
      return isAuthenticated() && (getUserData().role == 'courier' || getUserData().role == 'Motorista');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role in ['Tienda', 'Motorista', 'Cliente', 'store', 'courier', 'customer'];
      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'displayName',
            'phone',
            'photoURL',
            'updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    // Stores collection rules
    match /stores/{storeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || (isStore() && (request.auth.uid == storeId || getUserData().storeId == storeId));
      allow delete: if isAdmin();
    }

    // Orders collection rules
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isStore() && (resource.data.storeId == request.auth.uid || resource.data.storeId == getUserData().storeId))
        || (isCourier() && resource.data.courierId == request.auth.uid);
      allow create: if isAdmin() || (isStore() && (request.resource.data.storeId == request.auth.uid || request.resource.data.storeId == getUserData().storeId));
      allow update: if isAdmin()
        || (isCourier() && resource.data.courierId == request.auth.uid)
        || (isStore() && (resource.data.storeId == request.auth.uid || resource.data.storeId == getUserData().storeId));
      allow delete: if isAdmin();

      // Subcollection order events
      match /events/{eventId} {
        allow read: if isAdmin()
          || (isStore() && (get(/databases/$(database)/documents/orders/$(orderId)).data.storeId == request.auth.uid
            || get(/databases/$(database)/documents/orders/$(orderId)).data.storeId == getUserData().storeId))
          || (isCourier() && get(/databases/$(database)/documents/orders/$(orderId)).data.courierId == request.auth.uid);
        allow create: if isAdmin()
          || (isCourier() && get(/databases/$(database)/documents/orders/$(orderId)).data.courierId == request.auth.uid);
      }
    }

    // Courier Profiles rules
    match /couriers/{courierId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Courier Locations rules
    match /courier_locations/{locationId} {
      allow create: if isCourier() && request.resource.data.courierUid == request.auth.uid;
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Courier Routes rules
    match /courier_routes/{routeId} {
      allow create, update: if isCourier() && request.resource.data.courierUid == request.auth.uid;
      allow read: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Settings rules
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
